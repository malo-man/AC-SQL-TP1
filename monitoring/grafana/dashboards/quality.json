{
  "uid": "tp3-quality",
  "title": "TP3 — Qualité des données",
  "description": "Contrôle qualité du mart : anomalies par dimension avant et après nettoyage, et suivi dans le temps.",
  "tags": [
    "tp3",
    "tmdb"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Score qualité du mart",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pipeline_dq_dimension_score{dimension=\"global\",phase=\"avant\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Moyenne des taux de conformité des 49 contrôles sur les données du TP2 (100 = aucune anomalie)."
    },
    {
      "type": "stat",
      "title": "Score après nettoyage",
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pipeline_dq_dimension_score{dimension=\"global\",phase=\"après\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Mêmes contrôles, repassés sur le schéma curated. Les anomalies restantes sont conservées volontairement."
    },
    {
      "type": "stat",
      "title": "Anomalies dans le mart",
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(pipeline_dq_control_anomalies{phase=\"avant\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Total des lignes en anomalie relevées sur le mart, toutes dimensions."
    },
    {
      "type": "stat",
      "title": "Anomalies résiduelles",
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(pipeline_dq_control_anomalies{phase=\"après\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Anomalies conservées après nettoyage : donnée absente à la source, rien de fiable à imputer."
    },
    {
      "type": "stat",
      "title": "Contrôles à traiter",
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mart"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"à traiter\" FROM dq.v_results_last WHERE verdict = 'à traiter'",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-mart"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Contrôles encore en anomalie après nettoyage sans que la matrice justifie leur conservation : doit rester à 0. Un contrôle conservé peut dépasser son seuil : c'est alors la source qui est en cause, pas le nettoyage."
    },
    {
      "type": "stat",
      "title": "Âge du dernier contrôle",
      "id": 6,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pipeline_load_run_age_seconds{pipeline_job=\"quality\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Temps écoulé depuis la dernière exécution de l'étape quality (lancée après chaque chargement)."
    },
    {
      "type": "bargauge",
      "title": "Score par dimension, avant et après",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 10,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pipeline_dq_dimension_score{dimension!=\"global\",phase=\"avant\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{dimension}} — avant"
        },
        {
          "expr": "pipeline_dq_dimension_score{dimension!=\"global\",phase=\"après\"}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{dimension}} — après"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 85,
          "max": 100,
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": "Moyenne des taux de conformité des contrôles de chaque dimension. L'échelle commence à 85 % pour rendre les écarts lisibles."
    },
    {
      "type": "timeseries",
      "title": "Anomalies du mart par dimension",
      "id": 8,
      "gridPos": {
        "x": 10,
        "y": 4,
        "w": 14,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (dimension) (pipeline_dq_control_anomalies{phase=\"avant\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{dimension}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Anomalies relevées sur le mart à chaque passage. Échelle logarithmique : le genre non renseigné des personnes (plusieurs dizaines de milliers) écraserait sinon les autres. Une baisse traduit une correction remontée dans le pipeline."
    },
    {
      "type": "table",
      "title": "Contrôles en anomalie (dernière exécution)",
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mart"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT control_id AS \"Contrôle\", dimension AS \"Dimension\", rule AS \"Règle\",\n       severity AS \"Sévérité\", anomalies_before AS \"Avant\", pct_before AS \"% avant\",\n       anomalies_after AS \"Après\", treatment AS \"Traitement\", verdict AS \"Verdict\"\nFROM dq.v_results_last\nWHERE anomalies_before > 0 OR anomalies_after > 0\nORDER BY priority DESC, control_id",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-mart"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Lu directement dans le schéma dq. Priorité = poids de la sévérité x taux d'anomalies."
    },
    {
      "type": "timeseries",
      "title": "Anomalies résiduelles par dimension",
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (dimension) (pipeline_dq_control_anomalies{phase=\"après\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{dimension}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Ce qui reste après nettoyage : uniquement des contrôles dont la matrice justifie la conservation."
    },
    {
      "type": "table",
      "title": "Corrections appliquées",
      "id": 11,
      "gridPos": {
        "x": 14,
        "y": 24,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mart"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT control_id AS \"Contrôle\", action AS \"Action\", table_name AS \"Table\",\n       column_name AS \"Colonne\", rows_corrected AS \"Lignes\"\nFROM dq.v_corrections_summary ORDER BY rows_corrected DESC",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-mart"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Journal agrégé de la dernière exécution (dq.corrections)."
    }
  ]
}
