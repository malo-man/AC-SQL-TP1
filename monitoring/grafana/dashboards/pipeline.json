          "legendFormat": "brut : messages dans le lac"
        },
        {
          "expr": "pipeline_load_run_distinct_movies_in{pipeline_job=\"aggregate\"}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "après dédoublonnage"
        },
        {
          "expr": "pipeline_clean_rows{table=\"movies\"}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "propre : films en base"
        }
