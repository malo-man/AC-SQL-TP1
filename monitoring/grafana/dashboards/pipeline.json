    {
      "type": "table",
      "title": "Dernière exécution de chaque job",
      "id": 29,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mart"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT job AS \"Job\", status AS \"Statut\", raw_rows_in AS \"Brut lu\",\n       distinct_movies_in AS \"Films distincts\", clean_rows_out AS \"Propre écrit\",\n       rejected_rows AS \"Rejeté\", imdb_matched AS \"Rapproché IMDb\",\n       round(duration_seconds, 1) AS \"Durée (s)\", finished_at AS \"Terminé\"\nFROM mart.v_raw_vs_clean ORDER BY job",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-mart"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Lu directement dans mart.load_runs : le bilan que Spark écrit à chaque passage."
