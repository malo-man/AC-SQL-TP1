# --- PostgreSQL (docker-compose + script Python) ---
POSTGRES_USER=tmdb
POSTGRES_PASSWORD=tmdb
POSTGRES_DB=tmdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- TMDB (source 1) ---
# Read Access Token (v4) : https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
TMDB_LANGUAGE=fr-FR

# --- IMDb (source 2) ---
# Datasets de https://datasets.imdbws.com, séparés par des virgules.
# Profil léger (défaut) : title.ratings seul, 9 Mo, suffit à l'enrichissement (note + votes).
# Profil complet : title.ratings,title.basics — ajoute année/durée/genres mais télécharge 228 Mo.
IMDB_DATASETS=title.ratings
IMDB_FETCH_INTERVAL_HOURS=24
IMDB_METRICS_PORT=9101

# --- Kafka ---
KAFKA_TOPIC=tmdb.movies.raw
KAFKA_TOPIC_PARTITIONS=1
# 7 jours : le Data Lake est la source de vérité, Kafka n'est qu'un tampon de transport
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_HEAP_OPTS=-Xmx512m -Xms256m
# Identifiant du cluster KRaft : le changer invalide le volume kafkadata existant
KAFKA_CLUSTER_ID=RJnINqC3SNigDRwEGFXbfw

# --- Producer TMDB ---
TMDB_LISTS=popular,top_rated
TMDB_MAX_PAGES=10
# 0 = collecte continue sans fin ; >0 = arrêt après N films (démo bornée)
TMDB_MAX_MOVIES=0
TMDB_POLL_INTERVAL_SECONDS=1.0
TMDB_METRICS_PORT=9102

# --- Writer Data Lake (consumer Kafka) ---
KAFKA_GROUP_ID=datalake-writer
# Un fichier est écrit dès que l'un des deux seuils est atteint
WRITER_BATCH_SIZE=200
WRITER_FLUSH_SECONDS=60
WRITER_METRICS_PORT=9103

# --- Jobs PySpark ---
SPARK_INTERVAL_MINUTES=5
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8
